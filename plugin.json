{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "redreplier",
  "version": "1.4.1",
  "description": "Monitor Reddit, Hacker News, X, Bluesky and Facebook for keyword mentions of your product, triage AI-scored leads and manage alerts from your AI agent.",
  "author": {
    "name": "RedReplier",
    "url": "https://redreplier.com"
  },
  "homepage": "https://redreplier.com",
  "repository": "https://github.com/RedReplier/claude-plugin",
  "license": "MIT",
  "keywords": ["reddit", "hacker-news", "social-listening", "leads", "mentions", "mcp"],
  "extensions": {
    "com.nousresearch.hermes": {
      "servers": {
        "redreplier": {
          "trust": "untrusted"
        }
      }
    }
  }
}
